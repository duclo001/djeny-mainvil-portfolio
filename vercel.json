{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(index|index2|index2_backup|contact|maintenance|blog|projects|contribution)\\.html$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/detail_[a-z-]+\\.html$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/",
      "dest": "/professional.html"
    },
    {
      "src": "/professional\\.html$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
