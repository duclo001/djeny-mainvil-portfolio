{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/index\\.html$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/index2_backup\\.html$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/contact\\.html$",
      "status": 301,
      "headers": {
        "Location": "/#contact"
      }
    },
    {
      "src": "/",
      "dest": "/index2.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
